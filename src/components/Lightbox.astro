---
import Icon from './Icon.astro';

// Full-screen image viewer. Any <button data-lightbox="<group>"> containing an <img>
// opens it; prev/next step through the visible buttons of that group.
// Add data-label="…" to a button to show a caption above the counter.
interface Props {
  group: string;
  label: string;
}
const { group, label } = Astro.props;
---
<dialog class="lightbox" aria-label={label} data-lightbox-dialog={group}>
  <button type="button" class="lb-btn lb-close" aria-label="Close image viewer" data-lb-close><Icon name="close" /></button>
  <img src="" alt="" data-lb-img />
  <div class="lb-controls">
    <button type="button" class="lb-btn" aria-label="Previous image" data-lb-prev><Icon name="prev" /></button>
    <div class="lb-meta">
      <div class="lb-label" data-lb-label></div>
      <div class="lb-count" data-lb-count></div>
    </div>
    <button type="button" class="lb-btn" aria-label="Next image" data-lb-next><Icon name="next" /></button>
  </div>
</dialog>

<style>
  .lightbox { position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; border: 0; padding: 72px 16px 24px; background: rgba(20, 17, 15, .94); color: var(--mist); }
  .lightbox[open] { display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .lightbox::backdrop { background: transparent; }
  .lightbox img { max-width: min(1000px, 100%); max-height: 74vh; width: auto; height: auto; object-fit: contain; border-radius: 12px; display: block; }
  .lb-btn { width: 48px; height: 48px; border-radius: 999px; border: 1px solid rgba(248, 244, 239, .4); background: transparent; color: var(--ivory); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .lb-close { position: absolute; top: 16px; right: 16px; }
  .lb-controls { margin-top: 20px; display: flex; align-items: center; gap: 20px; }
  .lb-meta { text-align: center; min-width: 160px; }
  .lb-label { font-size: 12px; font-weight: 500; letter-spacing: .22em; text-transform: uppercase; color: var(--gold); }
  .lb-label:empty { display: none; }
  .lb-count { font-size: 14px; color: var(--mist); }
</style>

<script>
  document.querySelectorAll<HTMLDialogElement>('[data-lightbox-dialog]').forEach((dialog) => {
    const group = dialog.dataset.lightboxDialog;
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const label = dialog.querySelector<HTMLElement>('[data-lb-label]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    let items: HTMLElement[] = [];
    let index = 0;

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const item = items[index];
      const thumb = item.querySelector('img')!;
      img.src = thumb.src;
      img.alt = thumb.alt;
      label.textContent = item.dataset.label ?? '';
      count.textContent = `${index + 1} / ${items.length}`;
    };

    document.querySelectorAll<HTMLElement>(`[data-lightbox="${group}"]`).forEach((btn) => {
      btn.addEventListener('click', () => {
        // Only step through tiles that are currently shown (e.g. after filtering).
        items = [...document.querySelectorAll<HTMLElement>(`[data-lightbox="${group}"]`)].filter((el) => !el.hidden);
        show(items.indexOf(btn));
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
  });
</script>
