---
import Icon from './Icon.astro';
import { site, mailtoWith, whatsappWith } from '../data/site';

// Closing call to action on the service pages.
interface Props {
  title: string;
  text: string;
  mailSubject: string;
  whatsappText: string;
}
const { title, text, mailSubject, whatsappText } = Astro.props;
---
<section id="contact" class="cta-section">
  <div class="wrap reveal cta-inner">
    <div class="ornament" aria-hidden="true"><span></span><span class="ornament-star">✦</span><span></span></div>
    <h2 class="script-title script-title--cta">{title}</h2>
    <p class="muted cta-text">{text}</p>
    <div class="btn-row cta-btns">
      <a class="btn btn-ink" href={mailtoWith(mailSubject)}><Icon name="mail" size={18} />Email me</a>
      <a class="btn btn-ghost" href={whatsappWith(whatsappText)} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />Message on WhatsApp</a>
    </div>
    <p class="muted cta-contact">{site.email} · {site.phoneDisplay}</p>
  </div>
</section>

<style>
  .cta-section { padding: 130px 0; }
  .cta-inner { max-width: 820px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .cta-text { max-width: 600px; }
  .cta-btns { justify-content: center; margin-top: 10px; }
  .cta-contact { margin-top: 4px !important; font-size: 15px; }
</style>
