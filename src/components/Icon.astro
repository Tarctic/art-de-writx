---
// Line icons used across the site (decorative; label the button or link instead).
interface Props {
  name: 'whatsapp' | 'mail' | 'instagram' | 'close' | 'menu' | 'prev' | 'next' | 'caret' | 'external';
  size?: number;
}
const { name, size = 20 } = Astro.props;
const strokeWidth = name === 'caret' ? 1.8 : name === 'external' ? 2 : 1.6;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'whatsapp' && (
    <>
      <path d="M3.5 20.5l1.4-4.1A8.5 8.5 0 1 1 8.2 19.3z" />
      <path d="M9 8.6c.2 2.9 2.6 5.3 5.6 5.6l1.1-1.2-1.8-.9-.9.7a5 5 0 0 1-2.4-2.4l.7-.9-.9-1.8z" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="M3.5 6.5l8.5 6.5 8.5-6.5" />
    </>
  )}
  {name === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r=".8" fill="currentColor" />
    </>
  )}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'prev' && <path d="M15 5l-7 7 7 7" />}
  {name === 'next' && <path d="M9 5l7 7-7 7" />}
  {name === 'caret' && <path d="M6 9l6 6 6-6" />}
  {name === 'external' && <path d="M7 17L17 7M9 7h8v8" />}
</svg>
