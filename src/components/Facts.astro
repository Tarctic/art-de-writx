---
import SectionHead from './SectionHead.astro';

// "Good to know" cards. A fact with `placeholder: true` is still to be filled in by the client.
export interface Fact {
  label: string;
  value: string;
  placeholder?: boolean;
}
interface Props {
  id?: string;
  title: string;
  facts: Fact[];
  columns?: 3 | 4;
}
const { id, title, facts, columns = 4 } = Astro.props;
---
<section id={id} class="section section--sand facts-section">
  <div class="wrap">
    <SectionHead eyebrow="Good to know" title={title} />
    <div class:list={['facts', `facts--${columns}`, 'reveal']}>
      {facts.map((f) => (
        <div class="fact">
          <div class="fact-label">{f.label}</div>
          {f.placeholder
            ? <div class="fact-value"><span class="ph">{f.value}</span></div>
            : <div class="fact-value fact-value--serif">{f.value}</div>}
        </div>
      ))}
    </div>
    <slot />
  </div>
</section>

<style>
  .facts-section { padding: 110px 0; margin-top: 80px; }
  .fact { background: var(--ivory); border-radius: 16px; padding: 28px 24px; }
  .fact-label { font-size: 12px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: var(--bronze); }
  .fact-value { margin-top: 10px; font-size: 16px; }
  .fact-value--serif { font-family: var(--serif); font-size: 24px; line-height: 1.3; }
</style>
