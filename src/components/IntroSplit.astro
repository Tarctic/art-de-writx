---
// Arched photo beside an intro: eyebrow, heading with a script accent, copy (slot) and one stat.
interface Props {
  image: string;
  alt: string;
  eyebrow: string;
  title: string;
  accent: string;
  stat: { value: string; label: string; small?: boolean };
}
const { image, alt, eyebrow, title, accent, stat } = Astro.props;
---
<section class="section">
  <div class="wrap split">
    <div class="reveal lift intro-media">
      <div class="arch"><img src={image} alt={alt} /></div>
    </div>
    <div class="reveal stack intro-copy">
      <p class="eyebrow">✦ {eyebrow}</p>
      <h2 class="title title--lg">{title} <span class="script-accent">{accent}</span></h2>
      <slot />
      <div class="intro-stat">
        <span class:list={['intro-stat-value', { small: stat.small }]}>{stat.value}</span>
        <span class="intro-stat-label">{stat.label}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .intro-media { max-width: 480px; width: 100%; margin: 0 auto; }
  .intro-copy { gap: 22px; }
  .intro-stat { display: flex; align-items: baseline; gap: 14px; padding-top: 18px; border-top: 1px solid var(--rule); }
  .intro-stat-value { font-family: var(--serif); font-size: 44px; font-weight: 500; line-height: 1; }
  .intro-stat-value.small { font-size: 30px; }
  .intro-stat-label { font-size: 12px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
</style>
