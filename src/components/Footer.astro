---
import Icon from './Icon.astro';
import { site, type PageKey } from '../data/site';

interface Props {
  current: PageKey;
}
const { current } = Astro.props;
const onHome = current === 'home';
const home = (hash: string) => (onHome ? `#${hash}` : `/#${hash}`);
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <img src="/images/logo-light.png" alt="" aria-hidden="true" class="footer-logo" width="192" height="64" />
    <div>
      <p class="footer-name">{site.name}</p>
      <p class="footer-tagline">{site.tagline}</p>
      <p class="footer-strap">{site.strapline}</p>
    </div>
    <div class="footer-icons">
      <a class="iconbtn" href={site.instagram} target="_blank" rel="noopener" aria-label={`Instagram: ${site.instagramHandle}`}><Icon name="instagram" /></a>
      <a class="iconbtn" href={site.whatsapp} target="_blank" rel="noopener" aria-label={`WhatsApp: ${site.phoneDisplay}`}><Icon name="whatsapp" /></a>
      <a class="iconbtn" href={`mailto:${site.email}`} aria-label={`Email: ${site.email}`}><Icon name="mail" /></a>
    </div>
    <nav aria-label="Footer" class="footer-nav">
      <a class="footlink" href={onHome ? '#home' : '/'}>Home</a>
      <a class="footlink" href={home('about')}>About</a>
      <a class="footlink" href={home('services')}>Services</a>
      <a class="footlink" href={home('portfolio')}>Portfolio</a>
      <a class="footlink" href="#contact">Contact</a>
    </nav>
    <p class="footer-copy">© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
  </div>
</footer>

<a class="fab" href={site.whatsapp} target="_blank" rel="noopener" aria-label="Message Art De Writx on WhatsApp">
  <Icon name="whatsapp" size={26} />
</a>

<style>
  .site-footer { background: var(--ink); color: var(--mist); padding: 88px 0 32px; }
  .footer-inner { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }
  .footer-logo { height: 64px; width: auto; display: block; }
  .footer-name { margin: 0; font-family: var(--script); font-size: 60px; line-height: 1; color: var(--ivory); }
  .footer-tagline { margin: 10px 0 0; font-size: 13px; font-weight: 500; letter-spacing: .26em; text-transform: uppercase; color: var(--gold); }
  .footer-strap { margin: 10px 0 0; font-family: var(--serif); font-style: italic; font-size: 20px; color: var(--mist); }
  .footer-icons { display: flex; gap: 14px; margin-top: 6px; }
  .iconbtn { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 999px; border: 1px solid rgba(248, 244, 239, .35); color: var(--ivory); transition: background-color .25s ease, color .25s ease, transform .25s ease; }
  .iconbtn:hover { background: var(--gold); color: var(--ink); border-color: var(--gold); transform: translateY(-2px); }
  .footer-nav { display: flex; flex-wrap: wrap; justify-content: center; column-gap: 32px; row-gap: 4px; margin-top: 10px; padding-top: 26px; border-top: 1px solid rgba(233, 223, 212, .18); width: 100%; max-width: 760px; }
  .footlink { font-family: var(--sans); font-size: 12px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; text-decoration: none; color: var(--mist); padding: 10px 0; }
  .footlink:hover { color: var(--gold); }
  .footer-copy { margin: 18px 0 0; font-size: 13px; color: var(--stone); }

  .fab { position: fixed; right: 18px; bottom: 18px; z-index: 60; width: 58px; height: 58px; border-radius: 999px; background: var(--ink); color: var(--ivory); display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 28px rgba(30, 26, 23, .28); border: 1px solid var(--gold); }
  @media (min-width: 900px) { .fab { display: none; } }
</style>
